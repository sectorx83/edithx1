# Groq chat provider (server-side only)
GROQ_API_KEY_1=
# Optional additional keys for quota/credential failover
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Optional single-key fallback or additional pool key
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# EDITH NETWORK integration (optional, server-side only)
EDITH_NETWORK_API_KEY=

# Supabase
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional Vite-exposed public Supabase values for client builds
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
