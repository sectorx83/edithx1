# Groq chat provider (server-side only)
GROQ_API_KEY_1=
# Optional additional keys for quota/credential failover
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Optional single-key fallback when no numbered keys are configured
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional Vite-exposed Supabase values for client builds
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
